rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is a verified Admin via email or users collection
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'chestacode@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. Workspaces & Nested Subcollections
    match /workspaces/{workspaceId} {
      allow read, write: if true;

      match /chat_messages/{messageId} {
        allow read, write: if true;
      }
      match /vault/{vaultId} {
        allow read, write: if true;
      }
      match /kanban_tickets/{ticketId} {
        allow read, write: if true;
      }
    }

    // Allow collectionGroup query for chat_messages
    match /{path=**}/chat_messages/{messageId} {
      allow read, write: if true;
    }

    // 2. Vault Assets
    match /vault_assets/{assetId} {
      allow read, write: if true;
    }

    // 3. AI Leads & Click Telemetry
    match /ai_leads/{leadId} {
      allow read, write: if true;
    }

    match /click_telemetry/{teleId} {
      allow read, write: if true;
    }
    
    match /live_visitors/{visitorId} {
      allow read, write: if true;
    }
    
    match /ai_chat_sessions/{sessionId} {
      allow read, write: if true;
    }

    // 4. Knowledge Base & System Configs
    match /knowledge_base/{docId} {
      allow read, write: if true;
    }

    match /ai_knowledge_base/{docId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /system/{docId} {
      allow read, write: if true;
    }

    match /system_config/{docId} {
      allow read, write: if true;
    }
    
    match /system_health/{docId} {
      allow read, write: if true;
    }
    
    match /system_metrics/{docId} {
      allow read, write: if true;
    }
    
    match /seo_settings/{docId} {
      allow read, write: if true;
    }
    
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /chat_history/{docId} {
      allow read, write: if true;
    }

    match /faqs/{docId} {
      allow read, write: if true;
    }

    match /newsletter_subscribers/{docId} {
      allow read, write: if true;
    }

    match /page_content/{docId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /blog_interactions/{document=**} {
      allow read, write: if true;
    }
  }
}

