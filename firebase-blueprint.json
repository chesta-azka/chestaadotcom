{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Represents a user in the system with permissions and profile info.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "admin"
          ],
          "description": "Access level of the user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "role"
      ]
    },
    "Post": {
      "title": "Journal Post",
      "description": "A blog article vetted by AI and editors.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string",
          "format": "uri"
        },
        "authorId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "published",
            "rejected"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "approvedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "content",
        "authorId",
        "status"
      ]
    },
    "BlogInteraction": {
      "title": "Blog Interaction Stats",
      "type": "object",
      "properties": {
        "likes": {
          "type": "number"
        },
        "viewCount": {
          "type": "number"
        }
      }
    },
    "Comment": {
      "title": "Blog Comment",
      "type": "object",
      "properties": {
        "authorName": {
          "type": "string",
          "maxLength": 50
        },
        "content": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string"
        },
        "moderationStatus": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "parentId": {
          "type": "string",
          "description": "ID of the parent comment if this is a reply"
        },
        "likes": {
          "type": "number"
        }
      },
      "required": [
        "authorName",
        "content",
        "createdAt",
        "moderationStatus"
      ]
    },
    "Poll": {
      "title": "Interactive Poll",
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string" }
      }
    },
    "PollVote": {
      "title": "Poll Vote",
      "type": "object",
      "properties": {
        "pollId": { "type": "string" },
        "optionIndex": { "type": "number" },
        "userId": { "type": "string" },
        "votedAt": { "type": "string" }
      }
    },
    "FAQ": {
      "title": "Service FAQ",
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        },
        "serviceSlug": {
          "type": "string"
        },
        "order": {
          "type": "number"
        }
      }
    },
    "NewsletterSubscriber": {
      "title": "Newsletter Subscriber",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "email",
        "createdAt"
      ]
    },
    "KnowledgeNode": {
      "title": "Knowledge Node",
      "description": "A vectorized RAG knowledge unit in the AI Brain Graph.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "embedding": { "type": "array", "items": { "type": "number" } },
        "source": { "type": "string" },
        "confidence": { "type": "number" },
        "syncedAt": { "type": "string", "format": "date-time" },
        "accessCount": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "required": [
        "title",
        "content",
        "category"
      ]
    },
    "ChatSession": {
      "title": "Client Chat Session",
      "description": "Persistent conversation session storing messages for anonymous returning clients.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "messages": { "type": "array" },
        "lastUpdated": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      },
      "required": ["sessionId", "messages"]
    }
  },
  "firestore": {
    "/chat_sessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "Anonymous client chat sessions with seamless conversation persistence."
    },
    "/knowledge_nodes/{nodeId}": {
      "schema": "KnowledgeNode",
      "description": "Vectorized knowledge brain units for real-time RAG and continuous learning."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Primary user profiles."
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Journal articles and drafts."
    },
    "/blog_interactions/{slug}": {
      "schema": "BlogInteraction",
      "description": "Stats like likes and views for a blog post"
    },
    "/blog_interactions/{slug}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Comments on a blog post"
    },
    "/polls/{pollId}": {
      "schema": "Poll",
      "description": "Global poll questions"
    },
    "/polls/{pollId}/votes/{voteId}": {
      "schema": "PollVote",
      "description": "Individual votes for a poll"
    },
    "/faqs/{faqId}": {
      "schema": "FAQ",
      "description": "FAQs for services"
    },
    "/newsletter_subscribers/{docId}": {
      "schema": "NewsletterSubscriber",
      "description": "Newsletter email subscriptions"
    }
  }
}